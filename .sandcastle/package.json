{
  "name": "agentic-orchestrator",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Sandcastle-based /afk orchestrator: works each ready-for-agent issue in its own disposable, git-isolated sandbox and opens a PR per issue.",
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:integration": "SANDCASTLE_INTEGRATION=1 node --import tsx --test src/integration.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.14.0",
    "effect": "^4.1.3",
    "headroom-ai": "^0.44.0"
  }
}
