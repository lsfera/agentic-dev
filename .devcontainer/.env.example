# Template for .devcontainer/.env — entirely OPTIONAL.
# docker-compose.yml carries a fallback for every variable below, so a bare
# `docker compose up` works with no .env. Create one only to override a default
# (e.g. a non-standard ssh-agent or docker socket path). The dogfood path (`up.sh` /
# `devcontainer up`) generates the workspace vars automatically via init.sh.
# Copy to .env and adjust the values you care about; do not commit .env.

# Host ssh-agent socket forwarded for git auth (ADR-0026) — keys stay in the
# host keychain/agent, never in the container.
# Docker Desktop (macOS/Windows/Linux): /run/host-services/ssh-auth.sock
# Native Docker Engine on Linux:        the host's $SSH_AUTH_SOCK
SSH_AUTH_SOCK_HOST=/run/host-services/ssh-auth.sock

# Claude Code config, memory, and MCP registrations persist here across rebuilds.
CLAUDE_PERSIST_HOST_DIR=/Users/CHANGE_ME/.devcontainer-claude

# Docker socket path (bind-mounted into the container; the docker-outside-of-docker
# feature installs the CLI and fixes its permissions at startup).
# Docker Desktop (macOS/Windows): /var/run/docker.sock
# Rootless Docker on Linux:       /run/user/<UID>/docker.sock
DOCKER_SOCK=/var/run/docker.sock

# Workspace paths. On the dogfood path init.sh writes these on every open; standalone,
# they default to ${PWD} and /workspace. Only set them to override.
LOCAL_WORKSPACE_FOLDER=/path/to/leo
WORKSPACE_FOLDER=/workspaces/leo
